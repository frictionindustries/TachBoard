# Copy this file to `.env` and fill in your values, then run:
#   docker compose up -d
#
# `.env` is gitignored, so your real secrets stay out of version control and
# `git pull` will never conflict on them. This `.env.example` is safe to commit
# and serves as the documented list of every supported variable.

# ── Optional: JWT secret ──────────────────────────────────────
# Provide your own strong secret. If unset, the server auto-generates one
# and persists it in the /data volume on first run.
# JWT_SECRET=

# ── Optional: total upload storage cap ────────────────────────
# Maximum combined size (in bytes) of all uploaded images/videos, so uploads
# can never fill the data volume that also holds the database.
# Defaults to 5GB (5368709120).
# UPLOADS_MAX_TOTAL_BYTES=5368709120

# ── Optional: host port ───────────────────────────────────────
# The app always listens on 20028 inside the container; this only changes the
# host port mapping.
# PORT=20028

# ── Optional: Google (Gmail + Google Calendar tiles) ─────────
# Create an OAuth 2.0 Client ID (type "Web application") in Google Cloud
# Console (APIs & Services → Credentials) and enable the Gmail API and
# Google Calendar API. Then add your dashboard's redirect URI to the
# client's "Authorized redirect URIs" — the exact value is shown on the
# dashboard's Settings page (Google card) with a Copy button. It looks like:
#   http://<the-url-you-open-the-dashboard-at>/api/widgets/gmail/callback
#
# IMPORTANT: Google only accepts plain-http redirect URIs for localhost
# (http://localhost:20028/... works). A LAN IP like http://192.168.1.50:20028
# will be REJECTED by Google — use http://localhost via the host machine or
# an SSH tunnel/port-forward, or serve the dashboard over HTTPS with a real
# hostname (e.g. behind Nginx Proxy Manager) and register that URI instead.
# Console changes can take a few minutes to propagate.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret

# ── Optional: TrueNAS SCALE ───────────────────────────────────
# TRUENAS_URL=http://your-truenas-ip
# TRUENAS_API_KEY=your-truenas-api-key

# ── Optional: Media Server (Plex or Jellyfin) ─────────────────
# MEDIA_SERVER_TYPE=jellyfin   # or "plex"
# MEDIA_SERVER_URL=http://your-media-server:8096
# MEDIA_SERVER_API_KEY=your-api-key

# ── Optional: Sonarr ──────────────────────────────────────────
# SONARR_URL=http://your-sonarr:8989
# SONARR_API_KEY=your-sonarr-api-key

# ── Optional: Radarr ──────────────────────────────────────────
# RADARR_URL=http://your-radarr:7878
# RADARR_API_KEY=your-radarr-api-key

# ── Optional: qBittorrent ─────────────────────────────────────
# QBITTORRENT_URL=http://your-qbittorrent:8080
# QBITTORRENT_USERNAME=admin
# QBITTORRENT_PASSWORD=your-qbittorrent-password

# ── Optional: Pi-hole ─────────────────────────────────────────
# PIHOLE_URL=http://your-pihole
# PIHOLE_API_KEY=your-pihole-api-token

# ── Optional: Nginx Proxy Manager ─────────────────────────────
# NPM_URL must point at the ADMIN/API port (81 by default), NOT the
# proxied site on 80/443.
# NPM_URL=http://your-npm-host:81
# NPM_EMAIL=admin@example.com
# NPM_PASSWORD=your-npm-admin-password
